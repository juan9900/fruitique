---
import LocationPage from "../../../components/LocationPage.astro";
import { cities, retailers } from "../../../data/locations";
export function getStaticPaths() {
  return [...cities, ...retailers].map((g) => ({ params: { slug: g.slug }, props: { kind: "name" in g ? "retailer" : "city" } }));
}
const { slug } = Astro.params;
const { kind } = Astro.props;
---
<LocationPage locale="es" kind={kind} slug={slug!} />
