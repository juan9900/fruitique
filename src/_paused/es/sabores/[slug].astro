---
import CatalogDetail from "../../../components/CatalogDetail.astro";
import { flavors, flavorSlug } from "../../../data/flavors";
export function getStaticPaths() {
  return flavors.map((x) => ({ params: { slug: flavorSlug(x, "es") } }));
}
const { slug } = Astro.params;
---
<CatalogDetail locale="es" kind="flavors" slug={slug!} />
