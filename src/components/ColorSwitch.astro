---
/** TEMPORAL: botones flotantes para que la clienta compare el color de la interfaz (rojo vs turquesa). Quitar de BaseLayout cuando decida. */
---
<div class="cs" role="group" aria-label="Site color preview">
  <button type="button" data-ui="#ed1d24" style="--c:#ed1d24" aria-label="Red"></button>
  <button type="button" data-ui="#27bdbe" style="--c:#27bdbe" aria-label="Turquoise"></button>
</div>
<script>
  const root = document.documentElement;
  const mark = () => document.querySelectorAll<HTMLButtonElement>('.cs button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.ui === getComputedStyle(root).getPropertyValue('--fq-ui').trim())));
  mark();
  document.querySelectorAll<HTMLButtonElement>('.cs button').forEach((b) => b.addEventListener('click', () => {
    root.style.setProperty('--fq-ui', b.dataset.ui!);
    try { localStorage.setItem('fq-ui', b.dataset.ui!); } catch {}
    // el mapa lee el color al cargar
    if (document.querySelector('#loc-map, .homemap, [data-homemap]')) location.reload();
    else mark();
  }));
</script>
<style>
  .cs { position: fixed; right: .6rem; bottom: calc(.6rem + env(safe-area-inset-bottom)); z-index: 50; display: flex; gap: .5rem; padding: .4rem; background: var(--fq-white); border-radius: var(--radius-pill); box-shadow: 0 6px 18px rgb(0 0 0 / .3); }
  .cs button { width: 2.2rem; height: 2.2rem; border-radius: 50%; border: 3px solid var(--fq-white); background: var(--c); cursor: pointer; box-shadow: 0 0 0 2px rgb(0 0 0 / .15); }
  .cs button[aria-pressed='true'] { box-shadow: 0 0 0 3px var(--fq-ink); }
  .cs button:focus-visible { outline: 3px solid var(--fq-ink); outline-offset: 2px; }
</style>
