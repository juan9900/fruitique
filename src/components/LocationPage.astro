---
import BaseLayout from '../layouts/BaseLayout.astro';
import PartnerCta from './PartnerCta.astro';
import RetailerLogo from './RetailerLogo.astro';
import { cities, retailers, stateNames, statesOf, type Store } from '../data/locations';
import { localePath, useTranslations, type Locale } from '../i18n/ui';

interface Props { locale: Locale; kind: 'city' | 'retailer'; slug: string }
const { locale, kind, slug } = Astro.props;
const t = useTranslations(locale);
const base = (l: Locale) => localePath('whereToBuy', l);
const url = (l: Locale, s: string) => `${base(l)}${s}/`;
const abs = (path: string) => new URL(path, Astro.site).href;
const stateName = (code: string) => stateNames[code]?.[locale] ?? code;
const join = (arr: string[]) => {
  const and = locale === 'en' ? 'and' : 'y';
  return arr.length < 2 ? arr.join('') : `${arr.slice(0, -1).join(', ')} ${and} ${arr[arr.length - 1]}`;
};

const isCity = kind === 'city';
const group = isCity ? cities.find((c) => c.slug === slug)! : retailers.find((r) => r.slug === slug)!;
const list: Store[] = group.stores;
const heading = isCity
  ? (locale === 'en' ? `Fruitique in ${(group as any).city}, ${(group as any).state}` : `Fruitique en ${(group as any).city}, ${(group as any).state}`)
  : (locale === 'en' ? `Fruitique at ${(group as any).name}` : `Fruitique en ${(group as any).name}`);
const lead = isCity
  ? t('city.lead').replace('{n}', String(list.length)).replace('{city}', (group as any).city).replace('{state}', stateName((group as any).state))
  : t('retailer.lead').replace('{n}', String(list.length)).replace('{retailer}', (group as any).name).replace('{states}', join(statesOf(list).map(stateName)));
const metaTitle = `${heading} — ${locale === 'en' ? 'where to buy' : 'dónde comprar'}`;

// Para páginas de cadena, agrupar por estado y ciudad; para ciudad, lista plana.
const byCity = new Map<string, Store[]>();
for (const s of list) { const k = `${s.city}, ${s.state}`; byCity.set(k, [...(byCity.get(k) ?? []), s]); }
const sections = isCity ? [['', list] as [string, Store[]]] : [...byCity.entries()].sort((a, b) => a[0].localeCompare(b[0]));
const cityPageSlug = (s: Store) => cities.find((c) => c.city === s.city && c.state === s.state)?.slug;

const fullAddr = (s: Store) => [s.address, [s.city, s.state].filter(Boolean).join(', '), s.zip].filter(Boolean).join(', ');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Fruitique', item: abs(localePath('home', locale)) },
      { '@type': 'ListItem', position: 2, name: t('nav.whereToBuy'), item: abs(base(locale)) },
      { '@type': 'ListItem', position: 3, name: heading, item: abs(url(locale, slug)) },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: heading,
    itemListElement: list.slice(0, 100).map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Store',
        name: s.name,
        address: { '@type': 'PostalAddress', streetAddress: s.address, addressLocality: s.city, addressRegion: s.state, postalCode: s.zip, addressCountry: 'US' },
        geo: { '@type': 'GeoCoordinates', latitude: s.lat, longitude: s.lng },
      },
    })),
  },
];
const directions = (s: Store) => `https://www.google.com/maps/dir/?api=1&destination=${s.lat},${s.lng}`;
---
<BaseLayout locale={locale} title={metaTitle} description={lead} alternates={{ en: url('en', slug), es: url('es', slug) } as Record<Locale, string>} jsonLd={jsonLd}>
  <section class="intro">
    <div class="container">
      {!isCity && <div class="brand"><RetailerLogo slug={slug} name={heading} height="3.2rem" /></div>}
      <h1 data-split>{heading}</h1>
      <p class="lead">{lead}</p>
      <form id="zip-form" class="zipform" role="search" novalidate>
        <label class="sr-only" for="zip-q">{t('zip.label')}</label>
        <input id="zip-q" name="zip" type="text" autocomplete="off" placeholder={t('zip.placeholder')} required />
        <button class="btn btn--ghost" type="button" id="zip-clear" hidden>{t('zip.clear')}</button>
      </form>
      <p id="zip-msg" class="zipmsg" role="status" aria-live="polite"></p>
    </div>
  </section>
  <section class="locs">
    <div class="container">
      {sections.map(([title, rows]) => (
        <div class="block" data-block>
          {title && (() => { const sl = cityPageSlug(rows[0]); return sl ? <h2><a href={url(locale, sl)}>{title}</a></h2> : <h2>{title}</h2>; })()}
          <ul>
            {rows.map((s) => (
              <li data-lat={s.lat} data-lng={s.lng} data-city={s.city} data-state={s.state}>
                <div>
                  <strong>{s.name}</strong>
                  <span>{fullAddr(s)}</span>
                </div>
                <a href={directions(s)} target="_blank" rel="noopener">{t('list.directions')}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
  <PartnerCta locale={locale} tone="cream" />
</BaseLayout>
<script is:inline define:vars={{ msgs: { near: t('zip.near'), nearest: t('zip.nearest'), invalid: t('zip.invalid'), found: t('zip.found'), none: t('zip.none') }, states: Object.fromEntries(Object.entries(stateNames).map(([k, v]) => [k, [v.en, v.es]])) }}>
  (function () {
    var form = document.getElementById('zip-form');
    if (!form) return;
    var input = document.getElementById('zip-q'), clear = document.getElementById('zip-clear'), msg = document.getElementById('zip-msg');
    var wrap = document.querySelector('.locs .container');
    var blocks = Array.prototype.slice.call(wrap.querySelectorAll('[data-block]'));
    var items = Array.prototype.slice.call(wrap.querySelectorAll('li[data-lat]'));
    var order = items.map(function (li) { return { li: li, parent: li.parentNode }; });
    var origBlocks = blocks.slice();
    var zips = null, RADIUS = 25, NEAREST = 6;
    function norm(x) { return x.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9 ]/g, ' ').replace(/\s+/g, ' ').trim(); }
    function stateCode(x) {
      var n = norm(x);
      if (!n) return null;
      for (var k in states) { if (norm(k) === n || states[k].some(function (v) { return norm(v) === n; })) return k; }
      return null;
    }
    function miles(a, b, c, d) {
      var r = Math.PI / 180, dLat = (c - a) * r, dLng = (d - b) * r;
      var h = Math.sin(dLat / 2) * Math.sin(dLat / 2) + Math.cos(a * r) * Math.cos(c * r) * Math.sin(dLng / 2) * Math.sin(dLng / 2);
      return 3958.8 * 2 * Math.asin(Math.sqrt(h));
    }
    function clean() {
      order.forEach(function (o) { o.parent.appendChild(o.li); o.li.hidden = false; var d = o.li.querySelector('.dist'); if (d) d.remove(); });
      origBlocks.forEach(function (b) { b.hidden = false; wrap.appendChild(b); });
    }
    function reset() { clean(); msg.textContent = ''; clear.hidden = true; }
    function fmt(t, o) { return t.replace(/\{(\w+)\}/g, function (_, k) { return o[k]; }); }
    function hideEmpty() { origBlocks.forEach(function (b) { b.hidden = !b.querySelector('li:not([hidden])'); }); }
    function byZip(zip) {
      var c = zips[zip];
      if (!c) { msg.textContent = msgs.invalid; return; }
      clean();
      var rows = items.map(function (li) { return { li: li, d: miles(c[0], c[1], +li.dataset.lat, +li.dataset.lng) }; }).sort(function (a, b) { return a.d - b.d; });
      var shown = rows.filter(function (r) { return r.d <= RADIUS; });
      var within = shown.length > 0;
      if (!within) shown = rows.slice(0, NEAREST);
      var keep = new Set(shown.map(function (r) { return r.li; }));
      rows.forEach(function (r) {
        r.li.hidden = !keep.has(r.li);
        if (keep.has(r.li)) { var s = document.createElement('span'); s.className = 'dist'; s.textContent = r.d.toFixed(1) + ' mi'; r.li.firstElementChild.appendChild(s); }
        r.li.parentNode.appendChild(r.li);
      });
      hideEmpty();
      function best(x) { var m = Infinity; rows.forEach(function (r) { if (x.contains(r.li) && keep.has(r.li) && r.d < m) m = r.d; }); return m; }
      origBlocks.slice().sort(function (a, b) { return best(a) - best(b); }).forEach(function (b) { wrap.appendChild(b); });
      msg.textContent = fmt(within ? msgs.near : msgs.nearest, { n: shown.length, mi: RADIUS, zip: zip });
      clear.hidden = false;
    }
    function byText(q) {
      var city = norm(q), st = null, m;
      var whole = stateCode(q);
      if (whole) { st = whole; city = ''; }
      else if (q.indexOf(',') > -1) {
        var parts = q.split(','); st = stateCode(parts.slice(1).join(',')); city = norm(parts[0]);
      } else {
        // "miami fl" / "new york new york": probar sufijos como estado
        var w = city.split(' ');
        for (var i = 1; i < w.length && !st; i++) { var c = stateCode(w.slice(i).join(' ')); if (c) { st = c; city = w.slice(0, i).join(' '); } }
      }
      clean();
      var n = 0;
      items.forEach(function (li) {
        var ok = (!st || li.dataset.state === st) && (!city || norm(li.dataset.city).indexOf(city) > -1);
        li.hidden = !ok; if (ok) n++;
      });
      hideEmpty();
      clear.hidden = false;
      msg.textContent = n ? fmt(msgs.found, { n: n, q: q.trim() }) : fmt(msgs.none, { q: q.trim() });
    }
    var timer = null;
    function loadZips() {
      if (zips) return Promise.resolve(zips);
      return fetch('/data/zips.json').then(function (r) { return r.json(); }).then(function (z) { zips = z; return z; });
    }
    function run() {
      var q = input.value.trim();
      if (!q) { reset(); return; }
      if (/^\d+$/.test(q)) {
        if (q.length < 5) { clean(); msg.textContent = ''; clear.hidden = false; return; }
        var zip = q.slice(0, 5);
        loadZips().then(function () { if (input.value.trim() === q) byZip(zip); }).catch(function () { msg.textContent = msgs.invalid; });
        return;
      }
      var z5 = (q.match(/\b\d{5}\b/) || [])[0];
      if (z5) { loadZips().then(function () { if (input.value.trim() === q) byZip(z5); }).catch(function () { msg.textContent = msgs.invalid; }); return; }
      byText(q);
    }
    form.addEventListener('submit', function (e) { e.preventDefault(); clearTimeout(timer); run(); });
    input.addEventListener('focus', function () { loadZips().catch(function () {}); }, { once: true });
    input.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(run, 150); });
    clear.addEventListener('click', function () { input.value = ''; reset(); input.focus(); });
  })();
</script>
<style>
  .intro { padding-block: clamp(2.5rem, 7vw, 5rem) 1.5rem; }
  .intro h1 { font-size: clamp(2.4rem, 7vw, 4.8rem); color: var(--fq-red); max-width: 16ch; }
  .zipform { display: flex; flex-wrap: wrap; gap: .75rem; max-width: 34rem; }
  .zipform input { flex: 1 1 12rem; padding: .85rem 1.3rem; border-radius: var(--radius-pill); border: 2px solid var(--fq-red); font: 400 1.05rem var(--font-body); color: var(--fq-ink); background: var(--fq-white); }
  .btn--ghost { background: transparent; color: var(--fq-red); box-shadow: inset 0 0 0 2px var(--fq-red); }
  .zipmsg { margin: .8rem 0 0; font-weight: 600; min-height: 1.5em; }
  li :global(.dist) { font-weight: 600; color: var(--fq-red); opacity: 1; }
  [hidden] { display: none !important; }
  .lead { font-size: 1.2rem; max-width: 38rem; margin: 0 0 1.5rem; }
  .brand { margin-bottom: 1rem; }
  .locs { padding-block: 1rem clamp(3rem, 8vw, 6rem); }
  .block + .block { margin-top: 2rem; }
  h2 { font-size: 1.5rem; color: var(--fq-red); }
  h2 a { text-decoration: none; }
  h2 a:hover { text-decoration: underline; text-underline-offset: 5px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr)); }
  li { background: var(--fq-white); border-radius: .8rem; padding: .9rem 1.1rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  li div { display: grid; }
  li strong { font-weight: 700; }
  li span { font-size: .9rem; opacity: .8; }
  li a { color: var(--fq-red); font-weight: 700; white-space: nowrap; text-underline-offset: 4px; }
</style>
