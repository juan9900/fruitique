---
import { Image } from 'astro:assets';
import ProductArt from './ProductArt.astro';
import { mediaOf, productMedia } from '../data/media';
import type { Locale } from '../i18n/ui';
/** Card de sabor/producto: foto a sangre con el nombre sobre franja de color; sin foto, el envase; sin envase, la ilustración. */
interface Props {
  locale: Locale;
  kind: 'flavors' | 'products';
  /** `kind` de la línea de producto (pint, popsicle…): la card muestra el envase del sabor en esa línea, nunca una foto suelta. */
  line?: string;
  it: { slug: string; name: string; href: string; bg: string; ink: string; pop: string; accent: string; art: 'popsicle' | 'squarebar' | 'pint' | 'sandwich' };
}
const { locale, kind, line, it } = Astro.props;
const m = kind === 'flavors' ? mediaOf(it.slug) : productMedia[it.slug];
const lineArt = line ? (m?.byLine?.[line] ?? (line === 'pint' ? m?.pack : undefined)) : undefined;
const photo = line ? undefined : (m?.photos[0] ?? (kind === 'flavors' ? m?.texture : undefined));
const pack = lineArt ?? m?.pack;
---
<a class="card" data-cream={it.bg === 'var(--fq-cream)' ? '' : undefined} href={it.href} data-reveal style={`--bg:${it.bg}; --ink:${it.ink}; --pop-body:${it.pop}; --pop-accent:${it.accent}`}>
  {photo
    ? <Image src={photo} alt="" class="photo" widths={[400, 700]} sizes="(min-width: 60rem) 20rem, 90vw" />
    : <span class="flat">{pack
      ? <Image src={pack} alt="" class="art real" widths={[240, 400]} sizes="(min-width: 60rem) 14rem, 45vw" />
      : <ProductArt kind={it.art} class="art" />}</span>}
  <span class="label"><span class="name">{it.name}</span><span class="go">{locale === 'en' ? 'See more →' : 'Ver más →'}</span></span>
</a>
<style>
  .card { position: relative; display: flex; flex-direction: column; justify-content: flex-end; --label-h: 7.5rem; aspect-ratio: 4 / 5; border-radius: var(--radius); background: var(--bg); color: var(--ink); text-decoration: none; overflow: hidden; transition: transform .25s ease; }
  /* fondo crema = fondo de la página: contorno para que la card se vea */
  .card[data-cream]::after { content: ''; position: absolute; inset: 0; border-radius: inherit; box-shadow: inset 0 0 0 3px var(--fq-red); pointer-events: none; }
  .card:hover, .card:focus-visible { transform: translateY(-6px); }
  .card :global(.photo) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .card:hover :global(.photo), .card:focus-visible :global(.photo) { transform: scale(1.06); }
  .flat { position: absolute; inset: 0 0 var(--label-h); display: flex; align-items: center; justify-content: center; padding: 1.25rem 1rem; }
  .flat :global(.art) { width: 45%; height: auto; max-height: 100%; transition: transform .35s cubic-bezier(.3,1.6,.5,1); filter: drop-shadow(0 12px 0 rgb(0 0 0 / .12)); }
  .flat :global(.art.real) { width: 100%; height: 100%; min-height: 0; object-fit: contain; filter: none; }
  .card:hover .flat :global(.art), .card:focus-visible .flat :global(.art) { transform: rotate(8deg) translateY(-6px) scale(1.05); }
  .label { position: relative; display: flex; flex-direction: column; justify-content: space-between; gap: .25rem; height: var(--label-h); padding: 1rem 1.25rem 1.1rem; background: var(--bg); }
  .name { font: italic 700 clamp(1.15rem, 1.9vw, 1.6rem) var(--font-accent); line-height: 1.08; overflow-wrap: break-word; hyphens: manual; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .go { font-weight: 700; font-size: .95rem; }
</style>
