---
import Popsicle from './Popsicle.astro';
/* Ilustraciones provisionales de cada formato (hasta tener fotos de producto). */
interface Props { kind: 'popsicle' | 'squarebar' | 'pint' | 'sandwich'; class?: string }
const { kind, class: cls } = Astro.props;
---
{kind === 'popsicle' && <Popsicle class={cls} />}
{(kind === 'squarebar' || kind === 'sandwich') && (
  <svg class={cls} viewBox="0 0 140 220" aria-hidden="true" focusable="false">
    <rect x="62" y="150" width="16" height="64" rx="8" fill="var(--pop-accent, var(--fq-yellow))" />
    <path d="M22 18 h96 l-8 140 H30 Z" fill="var(--pop-body, var(--fq-white))" />
    <path d="M48 84 q22 26 44 0" stroke="var(--pop-accent, var(--fq-yellow))" stroke-width="8" stroke-linecap="round" fill="none" />
  </svg>
)}
{kind === 'pint' && (
  <svg class={cls} viewBox="0 0 160 200" aria-hidden="true" focusable="false">
    <rect x="22" y="20" width="116" height="26" rx="10" fill="var(--pop-body, var(--fq-red))" />
    <path d="M30 40 h100 l-10 140 a10 10 0 0 1 -10 9 H50 a10 10 0 0 1 -10 -9 Z" fill="var(--pop-body, var(--fq-red))" />
    <path d="M58 98 q22 26 44 0" stroke="var(--pop-accent, var(--fq-white))" stroke-width="8" stroke-linecap="round" fill="none" />
  </svg>
)}
