---
import BaseLayout from '../layouts/BaseLayout.astro';
import RetailerLogo from './RetailerLogo.astro';
import { retailerLogo } from '../data/retailer-logos';
import PartnerCta from './PartnerCta.astro';
import { cities, retailers, stateNames } from '../data/locations';
import { localePath, useTranslations, type Locale } from '../i18n/ui';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const title = locale === 'en' ? 'Where to buy Fruitique — find locations near you' : 'Dónde comprar Fruitique — ubicaciones cerca de ti';
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Fruitique', item: new URL(localePath('home', locale), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: t('nav.whereToBuy'), item: new URL(localePath('whereToBuy', locale), Astro.site).href },
  ],
};
const tint = ['red', 'yellow', 'turquoise', 'purple', 'red'];
const byState = Object.entries(
  cities.reduce<Record<string, typeof cities>>((acc, c) => ((acc[c.state] ??= []).push(c), acc), {}),
).sort((a, b) => b[1].reduce((n, c) => n + c.stores.length, 0) - a[1].reduce((n, c) => n + c.stores.length, 0));
const count = (n: number) => t('list.count').replace('{n}', String(n));
const config = {
  locale,
  labels: {
    closest: t('loc.closest'), directions: t('loc.directions'), more: t('loc.more'), noMatch: t('loc.noMatch'),
    geoError: t('loc.geoError'), far: t('loc.far'), loading: t('loc.loading'), mi: t('loc.mi'), none: t('loc.none'),
    all: t('loc.all'), independent: t('loc.independent'),
  },
};
---
<BaseLayout locale={locale} title={title} description={t('loc.lead')} alternates={{ en: localePath('whereToBuy', 'en'), es: localePath('whereToBuy', 'es') } as Record<Locale, string>} jsonLd={[crumbs]}>
  <section class="finder-hero">
    <div class="container">
      <h1 data-split>{t('loc.title')}</h1>
      <p class="lead">{t('loc.lead')}</p>
      <form id="loc-form" class="form" role="search" novalidate>
        <label class="sr-only" for="loc-q">{t('search.label')}</label>
        <input id="loc-q" name="q" type="text" autocomplete="postal-code" placeholder={t('search.placeholder')} required />
        <button class="btn btn--yellow" type="submit">{t('search.button')}</button>
        <button class="btn btn--ghost" type="button" id="loc-geo">{t('loc.geo')}</button>
      </form>
    </div>
  </section>

  <section class="results">
    <div class="container layout">
      <div class="panel">
        <div class="filter">
          <label for="loc-filter">{t('loc.show')}</label>
          <select id="loc-filter"></select>
        </div>
        <div id="loc-status" class="status" role="status" aria-live="polite">{t('loc.loading')}</div>
        <div id="loc-closest" class="closest" hidden></div>
        <div id="loc-more" hidden>
          <h2 class="more-title">{t('loc.more')}</h2>
          <ol id="loc-list" class="list"></ol>
        </div>
      </div>
      <div class="mapwrap"><div id="loc-map" role="region" aria-label={t('nav.whereToBuy')}></div></div>
    </div>
  </section>
  <section class="browse">
    <div class="container">
      <h2>{t('page.browseRetailer')}</h2>
      <div class="tiles">
        {retailers.map((r, i) => (
          <a class={`tile ${tint[i % tint.length]}`} href={`${localePath('whereToBuy', locale)}${r.slug}/`} data-reveal>
            {retailerLogo(r.slug)
              ? <RetailerLogo slug={r.slug} name={r.name} height="3rem" />
              : <span class="tn">{r.name}</span>}
            <span class="tc">{count(r.stores.length)}</span>
          </a>
        ))}
      </div>
      <h2 class="cities-h">{t('page.browseCity')}</h2>
      <div class="states">
        {byState.map(([code, list], i) => (
          <details open={i === 0}>
            <summary>{stateNames[code]?.[locale] ?? code}</summary>
            <ul>
              {list.map((c) => (
                <li><a href={`${localePath('whereToBuy', locale)}${c.slug}/`}><span>{c.city}</span><span class="n">{c.stores.length}</span></a></li>
              ))}
            </ul>
          </details>
        ))}
      </div>
    </div>
  </section>
  <PartnerCta locale={locale} tone="cream" />
  <script type="application/json" id="locator-config" set:html={JSON.stringify(config)} />
  <script>import '../scripts/locator';</script>
</BaseLayout>
<style>
  .finder-hero { background: var(--fq-red); color: var(--fq-white); padding-block: clamp(2rem, 5vw, 3.5rem); }
  h1 { font-size: clamp(2.4rem, 6vw, 4.2rem); max-width: 18ch; }
  .lead { font-size: 1.2rem; max-width: 36rem; }
  .form { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.5rem; max-width: 40rem; }
  .form input { flex: 1 1 15rem; padding: .85rem 1.3rem; border-radius: var(--radius-pill); border: 0; font: 400 1.05rem var(--font-body); color: var(--fq-ink); background: var(--fq-white); }
  .btn--ghost { background: transparent; color: var(--fq-white); box-shadow: inset 0 0 0 2px var(--fq-white); }
  .results { padding-block: 2rem 4rem; }
  .layout { display: grid; gap: 1.5rem; }
  @media (min-width: 60rem) { .layout { grid-template-columns: minmax(0, 26rem) 1fr; align-items: start; } .mapwrap { position: sticky; top: 5.5rem; } }
  .filter { display: flex; align-items: center; gap: .6rem; margin-bottom: 1rem; font-weight: 600; }
  .filter select { padding: .5rem .9rem; border-radius: var(--radius-pill); border: 2px solid var(--fq-red); background: var(--fq-white); color: var(--fq-ink); font: 600 .95rem var(--font-body); }
  .status { min-height: 1.5rem; margin-bottom: 1rem; }
  .closest { background: var(--fq-yellow); color: var(--fq-red); border-radius: var(--radius); padding: 1.5rem; margin-bottom: 1.5rem; }
  .closest :global(h2) { font-size: clamp(1.5rem, 3vw, 2rem); margin-bottom: .4em; }
  .closest :global(p) { margin: 0 0 1rem; color: var(--fq-ink); }
  .more-title { font-size: 1.2rem; color: var(--fq-red); }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; }
  .list :global(button) { width: 100%; text-align: left; background: var(--fq-white); border: 0; border-radius: .8rem; padding: .85rem 1rem; font: inherit; color: var(--fq-ink); cursor: pointer; display: flex; justify-content: space-between; gap: 1rem; }
  .list :global(button:hover) { background: var(--fq-white); outline: 2px solid var(--fq-red); }
  .list :global(.n) { font-weight: 700; display: block; }
  .list :global(.a) { font-size: .9rem; opacity: .8; }
  .list :global(.d) { font-weight: 700; color: var(--fq-red); white-space: nowrap; }
  .browse { padding-block: clamp(2rem, 6vw, 4rem) clamp(3rem, 8vw, 6rem); }
  .browse h2 { font-size: clamp(1.6rem, 3.5vw, 2.4rem); color: var(--fq-red); margin-bottom: 1rem; }
  .cities-h { margin-top: clamp(2.5rem, 6vw, 4rem); }
  .tiles { display: grid; gap: .75rem; grid-template-columns: repeat(auto-fit, minmax(12.5rem, 1fr)); }
  .tile { display: flex; flex-direction: column; justify-content: space-between; min-height: 9rem; padding: 1.1rem 1.2rem; border-radius: var(--radius); text-decoration: none; transition: transform .2s ease; }
  .tile:hover, .tile:focus-visible { transform: translateY(-4px) rotate(-.8deg); }
  .tile.red { background: var(--fq-red); color: var(--fq-white); }
  .tile.yellow { background: var(--fq-yellow); color: var(--fq-red); }
  .tile.turquoise { background: var(--fq-turquoise); color: var(--fq-ink); }
  .tile.purple { background: var(--fq-purple); color: var(--fq-white); }
  .tn { font: italic 700 clamp(1.2rem, 2vw, 1.55rem)/1.1 var(--font-accent); overflow-wrap: break-word; }
  .tc { font-size: .9rem; font-weight: 600; }
  .states { display: grid; gap: .6rem; }
  .states details { background: var(--fq-white); border-radius: var(--radius); padding: .25rem 1.2rem; }
  .states summary { cursor: pointer; font: 700 1.25rem var(--font-display); color: var(--fq-red); padding-block: .85rem; list-style: none; display: flex; justify-content: space-between; align-items: center; }
  .states summary::-webkit-details-marker { display: none; }
  .states summary::after { content: '+'; font-size: 1.6rem; line-height: 1; }
  .states details[open] summary::after { content: '–'; }
  .states ul { list-style: none; margin: 0; padding: 0 0 1rem; display: grid; gap: 0 2rem; grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr)); }
  .states li a { display: flex; justify-content: space-between; gap: 1rem; padding: .45rem 0; border-bottom: 1px solid rgb(0 0 0 / .08); text-decoration: none; font-weight: 600; }
  .states li a:hover span:first-child { color: var(--fq-red); text-decoration: underline; text-underline-offset: 4px; }
  .states .n { color: var(--fq-red); font-weight: 700; }
  #loc-map { height: min(70svh, 34rem); min-height: 20rem; border-radius: var(--radius); overflow: hidden; background: var(--fq-white); }
</style>
